# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required: Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Required for web search (ResearchAgent): free tier = 1000 calls/month
# Get one at https://tavily.com — no credit card needed
TAVILY_API_KEY=tvly-...

# Optional: Firecrawl — improves url_read / deep_web_research for JS-heavy sites
# Free tier: 500 credits/month. Get key at https://firecrawl.dev
# Without this, url_read falls back to trafilatura (free, works for most pages)
FIRECRAWL_API_KEY=fc-...

# Optional overrides (defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b-instruct
EMBED_MODEL=nomic-embed-text
CLOUD_MODEL=gemini-2.5-flash         # free/flash tier model
CLOUD_MODEL_PRO=gemini-2.5-pro       # pro tier model (override when Google releases a newer one)

# Cloud tier: "vertex" (Vertex AI via GCP credits — recommended while credits last)
#             "aistudio" (Google AI Studio free tier — fallback when credits run out)
#             "flash" (legacy alias for aistudio Flash)
#             "pro" (legacy alias for aistudio Pro)
CLOUD_TIER=vertex

# ─── Vertex AI (Google Cloud) ────────────────────────────────────────────────
# Auth: run `gcloud auth application-default login` once; ADC handles the rest.
# Find project ID at https://console.cloud.google.com (top-left selector).
GOOGLE_CLOUD_PROJECT=project-a5b9ea37-bda8-4075-b55
GOOGLE_CLOUD_REGION=europe-west1   # closest to Turkey; us-central1 is alternative

# Vertex model IDs (override only if Google releases a newer one)
VERTEX_MODEL_PRIMARY=gemini-2.5-pro
VERTEX_MODEL_FAST=gemini-2.5-flash

# Word count threshold above which messages auto-escalate to cloud (default: 50)
ESCALATION_WORD_THRESHOLD=50

# Vault and data directories (relative to project root)
VAULT_DIR=vault
CHROMA_DIR=data/chroma

# Your name (used in system prompt — change from "Sir" to your actual name if you like)
USER_NAME=Sir

# ─── Faz 8: Spotify ──────────────────────────────────────────────────────────
# Create a free Spotify Developer app at https://developer.spotify.com
# Set redirect URI in your app dashboard to: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ─── Faz 5: Budget tracker ────────────────────────────────────────────────────
# Your remaining Vertex AI credit amount in USD. Used by /budget to show remaining balance.
# Find current balance at https://console.cloud.google.com/billing
VERTEX_CREDIT_USD=350.0

# ─── Faz 5: MCP client layer ──────────────────────────────────────────────────
# Requires Node.js 18+ on PATH (for npx). Set True to give JARVIS real browser
# automation (navigate/click/type/screenshot/etc.) via Microsoft's official
# Playwright MCP server. First run downloads Chromium (~150-300MB) if not
# already installed -- run `npx -y playwright install chromium` once yourself
# to avoid that delay landing mid-conversation.
# Every Playwright action beyond pure inspection/navigation (click, type,
# fill_form, evaluate, ...) requires confirmation by default -- same gate as
# gmail send / shell_run -- see jarvis/mcp_integration.py.
MCP_PLAYWRIGHT_ENABLED=False
MCP_PLAYWRIGHT_HEADLESS=True

# Advanced: any other MCP server, as a JSON object (server name -> config).
# Same shape MultiServerMCPClient itself takes. Windows + npx-based servers
# MUST go through `cmd /c`, not bare `npx` (npx is npx.cmd, a batch shim --
# spawning it directly raises WinError 2; confirmed live on this project).
# Example (do not uncomment unless you actually have this server):
# MCP_SERVERS={"example":{"command":"cmd","args":["/c","npx","-y","@some/mcp-server"],"transport":"stdio"}}
