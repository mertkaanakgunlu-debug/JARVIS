# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Required: Gemini API key (free tier available at https://aistudio.google.com/apikey)
GEMINI_API_KEY=AIza...

# Required for web search (ResearchAgent): free tier = 1000 calls/month
# Get one at https://tavily.com — no credit card needed
TAVILY_API_KEY=tvly-...

# Optional: Firecrawl — improves url_read / deep_web_research for JS-heavy sites
# Free tier: 500 credits/month. Get key at https://firecrawl.dev
# Without this, url_read falls back to trafilatura (free, works for most pages)
FIRECRAWL_API_KEY=fc-...

# Optional overrides (defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3:8b
EMBED_MODEL=nomic-embed-text
CLOUD_MODEL=gemini-2.5-flash         # free/flash tier model
CLOUD_MODEL_PRO=gemini-2.5-pro       # pro tier model (override when Google releases a newer one)

# Cloud tier: "vertex" (Vertex AI via GCP credits — recommended while credits last)
#             "aistudio" (Google AI Studio free tier — fallback when credits run out)
#             "flash" (legacy alias for aistudio Flash)
#             "pro" (legacy alias for aistudio Pro)
CLOUD_TIER=vertex

# ─── Stabilization sprint (2026-07-16): CLOUD_POLICY ─────────────────────────
# Structural switch, independent of CLOUD_TIER above — decided AFTER a live
# manual-test session found AI Studio's key exhausted (429 prepayment-credits-
# depleted) and Vertex billing on every non-trivial turn despite the
# local-first pivot's intent (the routing-policy fix for THAT gap is tracked
# separately, not yet done — see HANDOFF.md).
#   off      (default) — no role, critic, planner, fallback, or background
#            extractor may construct/invoke a cloud model. Zero cloud spend,
#            guaranteed structurally, not by hoping the router behaves.
#   explicit — cloud only via a manual /model pin; nothing automatic.
#   auto     — pre-sprint behavior: routing/fallback decide freely.
# Uncomment to restore the pre-sprint behavior:
# CLOUD_POLICY=auto
# Patch 1.1 note: under `explicit`, the background direct-Gemini helpers
# (fact/entity/finance extractors, session summarizer, todo analyzer, email
# triage, pdf_vision, deep_research) are gated OFF too — a manual /model pin
# authorizes the conversation's answering model, not unprompted background
# cloud calls. Only `auto` enables them.

# ─── Patch 1.1: AI_STUDIO_BILLING_MODE ───────────────────────────────────────
# What an AI Studio (Gemini Developer API) call costs. A key can be free-tier
# OR paid (prepaid/pay-as-you-go) and the provider name can't tell you which —
# this repo's own key turned out to be a paid one with depleted credits while
# the code assumed aistudio == $0.
#   unknown — default: tokens tracked as "unpriced", surfaced in /status and
#             /budget, never silently asserted free.
#   free    — you verified the key is free-tier: cost is genuinely $0.
#   paid    — priced with the same Gemini table as Vertex.
# AI_STUDIO_BILLING_MODE=free

# ─── Vertex AI (Google Cloud) ────────────────────────────────────────────────
# Auth: run `gcloud auth application-default login` once; ADC handles the rest.
# Find project ID at https://console.cloud.google.com (top-left selector).
GOOGLE_CLOUD_PROJECT=project-a5b9ea37-bda8-4075-b55
GOOGLE_CLOUD_REGION=europe-west1   # closest to Turkey; us-central1 is alternative

# Vertex model IDs (override only if Google releases a newer one)
VERTEX_MODEL_PRIMARY=gemini-2.5-pro
VERTEX_MODEL_FAST=gemini-2.5-flash

# Word count threshold above which messages auto-escalate to cloud (default: 50)
ESCALATION_WORD_THRESHOLD=50

# Vault and data directories (relative to project root)
VAULT_DIR=vault
CHROMA_DIR=data/chroma

# Your name (used in system prompt — change from "Sir" to your actual name if you like)
USER_NAME=Sir

# ─── Faz 8: Spotify ──────────────────────────────────────────────────────────
# Create a free Spotify Developer app at https://developer.spotify.com
# Set redirect URI in your app dashboard to: http://localhost:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ─── Faz 5: Budget tracker ────────────────────────────────────────────────────
# Your remaining Vertex AI credit amount in USD. Used by /budget to show remaining balance.
# Find current balance at https://console.cloud.google.com/billing
VERTEX_CREDIT_USD=350.0

# ─── Faz 5: MCP client layer ──────────────────────────────────────────────────
# Requires Node.js 18+ on PATH (for npx). Set True to give JARVIS real browser
# automation (navigate/click/type/screenshot/etc.) via Microsoft's official
# Playwright MCP server. First run downloads Chromium (~150-300MB) if not
# already installed -- run `npx -y playwright install chromium` once yourself
# to avoid that delay landing mid-conversation.
# Every Playwright action beyond pure inspection/navigation (click, type,
# fill_form, evaluate, ...) requires confirmation by default -- same gate as
# gmail send / shell_run -- see jarvis/mcp_integration.py.
MCP_PLAYWRIGHT_ENABLED=False
MCP_PLAYWRIGHT_HEADLESS=True

# Advanced: any other MCP server, as a JSON object (server name -> config).
# Same shape MultiServerMCPClient itself takes. Windows + npx-based servers
# MUST go through `cmd /c`, not bare `npx` (npx is npx.cmd, a batch shim --
# spawning it directly raises WinError 2; confirmed live on this project).
# Example (do not uncomment unless you actually have this server):
# MCP_SERVERS={"example":{"command":"cmd","args":["/c","npx","-y","@some/mcp-server"],"transport":"stdio"}}

# ─── REST API server (python -m jarvis --api) ────────────────────────────────
# Empty JARVIS_API_KEY = auth disabled -- the server then refuses to bind to
# anything but loopback (127.0.0.1), fail-fast, rather than silently exposing
# an unauthenticated API. Set a real key here to reach JARVIS from your phone
# / over Tailscale; leave JARVIS_API_HOST unset once a key is set and it
# defaults to 0.0.0.0 (all interfaces) automatically.
JARVIS_API_KEY=
# JARVIS_API_HOST=127.0.0.1
# Extra CORS origins as a JSON array (Electron's file:// origin and any
# localhost/127.0.0.1 dev origin are always allowed regardless of this).
# JARVIS_API_CORS_ORIGINS=["http://192.168.1.50:3000"]

# ─── Faz 7: Proactive self-initiation ─────────────────────────────────────────
# Requires --monitor (CLI or --api). Off by default: with this False, the
# monitor still fires its existing toast/FCM notifications unchanged, but
# never calls into agent.chat() -- turning it on lets JARVIS look at a new
# email/calendar event and, if it judges it genuinely worth surfacing, send a
# proactive suggestion (subject to the exact same confirmation gate as a
# normal conversation -- see jarvis/agent.py's proactive_turn()).
MONITOR_PROACTIVE_ENABLED=False
# Minimum seconds between proactive agent turns, across all sources combined
# (prevents a burst of e.g. unread emails from queuing many LLM calls at once).
MONITOR_PROACTIVE_MIN_GAP_SEC=600

# ─── Stabilization sprint: JARVIS_HOME / EXTERNAL_WRITES_ENABLED ─────────────
# Not typical .env settings — both are meant to be set as PROCESS env vars for
# an isolated test run, not baked into your real .env. `python -m jarvis --api
# --profile test` sets both automatically (fresh temp JARVIS_HOME each run,
# EXTERNAL_WRITES_ENABLED=false) — see jarvis/__main__.py and jarvis/paths.py.
# Documented here for reference, left unset/commented in a real .env:
#
# JARVIS_HOME redirects EVERY runtime store (sessions.db, checkpoints, usage,
# audit log, kill switch, ChromaDB, vault, uploads, tool caches/outputs, and
# — unlike a plain `cd` — even the project-root-anchored Gmail/Calendar OAuth
# tokens) to live under that root instead of the repo. Unset = today's
# cwd-relative behavior, unchanged.
# JARVIS_HOME=C:\Temp\jarvis-e2e-run1
#
# Patch 1.1: `--profile test` deliberately IGNORES a pre-set JARVIS_HOME (a
# production value must never leak into an "isolated" test run) and always
# creates a fresh temp home. For a stable/repeatable test dir (CI), set the
# test-only variable instead:
# JARVIS_TEST_HOME=C:\Temp\jarvis-test
#
# EXTERNAL_WRITES_ENABLED=false hard-denies any external_write tool (gmail
# send, calendar create/delete, Drive upload/share/delete, Spotify) before the
# confirmation gate even runs — no prompt, no execution. Default true (no
# behavior change) for a real .env.
# EXTERNAL_WRITES_ENABLED=false
#
# Patch 1.2 (Faz 1B): deterministic, LLM-independent tool-call limits —
# enforced in the confirmation node before policy evaluation, independent of
# the capability router. Defaults shown; a hallucinated over-limit batch is
# rejected WHOLE (live incident A2: ~20 calls incl. 2 email sends from a
# one-line smalltalk turn). "Attempted" counts blocked calls too.
# MAX_TOOL_CALLS_PER_AI_MESSAGE=4
# MAX_TOOL_CALLS_PER_TURN=6
# MAX_IDENTICAL_TOOL_CALL=1
# MAX_TOOL_ROUNDS_PER_TURN=2
#
# Patch 1.2 (Faz 1D): history window in completed conversation TURNS (with
# turn compaction, one polluted turn can no longer evict the whole window —
# the A2→A3 recall failure). Default:
# MAX_CONVERSATION_TURNS=10
