# Secrets
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
# hypothesis example DB (Faz 8 property tests run derandomized, so this stays
# empty in CI -- but an exploratory local run without the profile writes here)
.hypothesis/

# Vector DB (writes frequently, noisy in OneDrive sync)
data/

# Vault — conversation logs are private; keep directory via .gitkeep
vault/conversations/*.md
vault/**/*.tmp

# Archives (e.g. Jarvis.rar backup)
*.rar

# Flutter / Dart build artifacts
mobile/.dart_tool/
mobile/build/
.dart_tool/

# Claude Code worktrees (scratch branches — not canonical)
.claude/worktrees/

# Node / Electron
node_modules/
electron/dist-electron/
electron/dist/
electron/out/

# Faz 5: Playwright MCP page-snapshot cache (runtime artifact, written to the
# repo root by @playwright/mcp itself -- not configurable to data/)
.playwright-mcp/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
desktop.ini

# Local dev server log
server.log

# Generated finance artifacts (contain REAL bank data)
exports/

# Live-gate measurement output (jarvis/evals/results.py) — kept out of git but
# never overwritten, so an earlier run can always be recomputed under a new rule.
.eval-results/
