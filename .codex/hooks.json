{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Set-Location (git rev-parse --show-toplevel); .venv/Scripts/python.exe scripts/claude_session_start.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"Set-Location (git rev-parse --show-toplevel); .venv/Scripts/python.exe scripts/claude_session_end.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
