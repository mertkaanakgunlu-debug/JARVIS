{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe scripts/claude_session_start.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".venv/Scripts/python.exe scripts/claude_session_end.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
